From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devilreef <devilreef@femboy.page>
Date: Fri, 1 May 2026 03:30:13 +0600
Subject: [PATCH] fire fast messages from chat-widget shortcut handlers

---
 Telegram/SourceFiles/history/history_widget.cpp      | 12 ++++++++++++
 .../history/view/history_view_chat_section.cpp       | 12 ++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "history/history_widget.h"
 
+#include "arcanegram/features/ag_fast_messages.h"
 #include "arcanegram/features/ag_hidden_users.h"
 #include "api/api_compose_with_ai.h"
 #include "api/api_editing.h"
@@ -2346,6 +2347,17 @@ void HistoryWidget::setupShortcuts() {
 				return true;
 			});
 		}
+		for (auto i = 0; i != 10; ++i) {
+			const auto cmd = Shortcuts::Command(
+				int(Shortcuts::Command::FastMessage1) + i);
+			if (request->check(cmd, 1)) {
+				request->handle([=, peer = _peer, reply = replyTo()] {
+					return peer
+						&& Arcanegram::FastMessages::Send(peer, reply, i);
+				});
+				break;
+			}
+		}
 	}, lifetime());
 }
 
diff --git a/Telegram/SourceFiles/history/view/history_view_chat_section.cpp b/Telegram/SourceFiles/history/view/history_view_chat_section.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/history/view/history_view_chat_section.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_chat_section.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "history/view/history_view_chat_section.h"
 
+#include "arcanegram/features/ag_fast_messages.h"
 #include "history/view/controls/history_view_compose_controls.h"
 #include "history/view/controls/history_view_compose_search.h"
 #include "history/view/controls/history_view_draft_options.h"
@@ -3539,6 +3540,17 @@ void ChatWidget::setupShortcuts() {
 			searchRequested();
 			return true;
 		});
+		for (auto i = 0; i != 10; ++i) {
+			const auto cmd = Shortcuts::Command(
+				int(Shortcuts::Command::FastMessage1) + i);
+			if (request->check(cmd, 1)) {
+				request->handle([=, peer = _history->peer, reply = replyTo()] {
+					return peer
+						&& Arcanegram::FastMessages::Send(peer, reply, i);
+				});
+				break;
+			}
+		}
 	}, lifetime());
 }
 
