From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devilreef <devilreef@shino.boo>
Date: Tue, 28 Apr 2026 03:37:45 +0600
Subject: [PATCH] override Element::isHidden() so HistoryInner and other views
 shrink hidden users

---
 .../SourceFiles/history/view/history_view_element.cpp     | 4 +++-
 .../SourceFiles/history/view/history_view_message.cpp     | 8 +++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/Telegram/SourceFiles/history/view/history_view_element.cpp b/Telegram/SourceFiles/history/view/history_view_element.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/history/view/history_view_element.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_element.cpp
@@ -9,6 +9,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 
 #include "apiwrap.h"
 #include "api/api_transcribes.h"
+#include "arcanegram/features/ag_hidden_users.h"
 #include "history/view/history_view_service_message.h"
 #include "history/view/history_view_message.h"
 #include "history/view/media/history_view_media_generic.h"
@@ -1421,7 +1422,8 @@ bool Element::isHiddenByGroup() const {
 }
 
 bool Element::isHidden() const {
-	return isHiddenByGroup();
+	return isHiddenByGroup()
+		|| Arcanegram::HiddenUsers::IsHiddenItem(data());
 }
 
 void Element::overrideMedia(std::unique_ptr<Media> media) {
diff --git a/Telegram/SourceFiles/history/view/history_view_message.cpp b/Telegram/SourceFiles/history/view/history_view_message.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/history/view/history_view_message.cpp
+++ b/Telegram/SourceFiles/history/view/history_view_message.cpp
@@ -9,6 +9,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 
 #include "api/api_suggest_post.h"
 #include "api/api_transcribes.h"
+#include "arcanegram/features/ag_hidden_users.h"
 #include "base/qt/qt_key_modifiers.h"
 #include "base/unixtime.h"
 #include "core/click_handler_types.h" // ClickHandlerContext
@@ -1064,6 +1065,9 @@ int Message::marginBottom() const {
 }
 
 void Message::draw(Painter &p, const PaintContext &context) const {
+	if (Arcanegram::HiddenUsers::IsHiddenItem(data())) {
+		return;
+	}
 	auto g = countGeometry();
 	if (g.width() < 1) {
 		return;
@@ -5177,7 +5181,9 @@ Ui::BubbleRounding Message::countBubbleRounding() const {
 }
 
 int Message::resizeContentGetHeight(int newWidth) {
-	if (isHidden()) {
+	if (Arcanegram::HiddenUsers::IsHiddenItem(data())) {
+		return 0;
+	} else if (isHidden()) {
 		return marginTop() + marginBottom();
 	} else if (newWidth < st::msgMinWidth) {
 		return height();
-- 
