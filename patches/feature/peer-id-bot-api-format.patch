From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devilreef <devilreef@femboy.page>
Date: Wed, 29 Apr 2026 14:06:53 +0600
Subject: [PATCH] show peer ids in bot api format by default; rmb to
 copy

mtproto
---
 .../info/profile/info_profile_actions.cpp     | 37 ++++++++++++++-----
 1 file changed, 27 insertions(+), 10 deletions(-)

diff --git a/Telegram/SourceFiles/info/profile/info_profile_actions.cpp b/Telegram/SourceFiles/info/profile/info_profile_actions.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/info/profile/info_profile_actions.cpp
+++ b/Telegram/SourceFiles/info/profile/info_profile_actions.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "info/profile/info_profile_actions.h"
 
+#include "arcanegram/features/ag_peer_ids.h"
 #include "api/api_blocked_peers.h"
 #include "api/api_chat_participants.h"
 #include "api/api_credits.h"
@@ -220,10 +221,12 @@ base::options::toggle ShowChannelJoinedBelowAbout({
 				value.append("\n\n");
 			}
 			value.append(Italic(u"id: "_q));
-			const auto raw = peer->id.value & PeerId::kChatTypeMask;
+			const auto botApi = Arcanegram::PeerIds::FormatBotApi(peer);
+			const auto mtproto = Arcanegram::PeerIds::FormatMtproto(peer);
 			value.append(Link(
-				Italic(Lang::FormatCountDecimal(raw)),
-				"internal:~peer_id~:copy:" + QString::number(raw)));
+				Italic(botApi),
+				"internal:~peer_id~:copy:" + botApi
+					+ ":mtproto:" + mtproto));
 		}
 		if (ShowChannelJoinedBelowAbout.value()) {
 			if (const auto channel = peer->asChannel()) {
@@ -1478,13 +1481,27 @@ object_ptr<Ui::RpWidget> DetailsFiller::setupInfo() {
 				const auto &url = request.link->url();
 				if (url.startsWith(u"internal:~peer_id~:"_q)) {
 					const auto weak = base::make_weak(controller);
-					request.menu->addAction(u"Copy ID"_q, [=] {
-						Core::App().openInternalUrl(
-							url,
-							QVariant::fromValue(ClickHandlerContext{
-								.sessionWindow = weak,
-							}));
-					});
+					const auto copy = [=](const QString &text) {
+						TextUtilities::SetClipboardText({ text });
+						if (const auto strong = weak.get()) {
+							strong->showToast(u"ID copied to clipboard."_q);
+						}
+					};
+					const auto prefix = u"internal:~peer_id~:copy:"_q;
+					const auto sep = u":mtproto:"_q;
+					const auto sepAt = url.indexOf(sep);
+					const auto botApi = (sepAt > 0)
+						? url.mid(prefix.size(), sepAt - prefix.size())
+						: url.mid(prefix.size());
+					const auto mtproto = (sepAt > 0)
+						? url.mid(sepAt + sep.size())
+						: botApi;
+					request.menu->addAction(
+						tr::ag_peer_id_copy_botapi(tr::now),
+						[=] { copy(botApi); });
+					request.menu->addAction(
+						tr::ag_peer_id_copy_mtproto(tr::now),
+						[=] { copy(mtproto); });
 					return;
 				}
 			}
-- 
