From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devilreef <devilreef@femboy.page>
Date: Thu, 7 May 2026 16:19:59 +0600
Subject: [PATCH] Skip popup notifications while Arcanegram streamer mode is
 active

---
 Telegram/SourceFiles/window/notifications_manager.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/window/notifications_manager.cpp b/Telegram/SourceFiles/window/notifications_manager.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/window/notifications_manager.cpp
+++ b/Telegram/SourceFiles/window/notifications_manager.cpp
@@ -8,6 +8,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "window/notifications_manager.h"
 
 #include "arcanegram/features/ag_hidden_users.h"
+#include "arcanegram/features/streamer_mode/ag_streamer_mode.h"
 #include "base/options.h"
 #include "base/platform/base_platform_info.h"
 #include "base/qt/qt_key_modifiers.h"
@@ -305,7 +306,8 @@ System::SkipState System::skipNotification(
 			&& skipSentNotification(item, _sentReactionNotifications))
 		|| (type == Data::ItemNotificationType::PollVote
 			&& skipSentNotification(item, _sentPollVoteNotifications))
-		|| Arcanegram::HiddenUsers::IsHiddenItem(item)) {
+		|| Arcanegram::HiddenUsers::IsHiddenItem(item)
+		|| Arcanegram::StreamerMode::IsActive()) {
 		return { SkipState::Skip };
 	}
 	return computeSkipState(notification);
-- 
2.52.0.windows.1

