From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devilreef <devilreef@femboy.page>
Date: Thu, 7 May 2026 16:03:00 +0600
Subject: [PATCH] Apply Windows display-affinity / NSWindowSharing flag from
 Arcanegram streamer mode to top-level widgets

---
 Telegram/SourceFiles/core/application.cpp                    | 3 +++
 Telegram/SourceFiles/iv/iv_controller.cpp                    | 3 +++
 .../SourceFiles/media/view/media_view_overlay_widget.cpp     | 3 +++
 Telegram/SourceFiles/media/view/media_view_pip.cpp           | 3 +++
 .../SourceFiles/window/notifications_manager_default.cpp     | 5 +++++
 5 files changed, 17 insertions(+)

diff --git a/Telegram/SourceFiles/core/application.cpp b/Telegram/SourceFiles/core/application.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/core/application.cpp
+++ b/Telegram/SourceFiles/core/application.cpp
@@ -28,6 +28,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "core/local_url_handlers.h"
 #include "core/launcher.h"
 #include "arcanegram/ag_hooks.h"
+#include "arcanegram/features/streamer_mode/ag_streamer_mode.h"
 #include "core/proxy_rotation_manager.h"
 #include "core/ui_integration.h"
 #include "chat_helpers/emoji_keywords.h"
@@ -534,6 +535,8 @@ void Application::processCreatedWindow(
 		not_null<Window::Controller*> window) {
 	window->openInMediaViewRequests(
 	) | rpl::start_to_stream(_openInMediaViewRequests, window->lifetime());
+
+	Arcanegram::StreamerMode::ApplyTo(window->widget());
 }
 
 void Application::startMediaView() {
diff --git a/Telegram/SourceFiles/iv/iv_controller.cpp b/Telegram/SourceFiles/iv/iv_controller.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/iv/iv_controller.cpp
+++ b/Telegram/SourceFiles/iv/iv_controller.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "iv/iv_controller.h"
 
+#include "arcanegram/features/streamer_mode/ag_streamer_mode.h"
 #include "base/event_filter.h"
 #include "base/platform/base_platform_info.h"
 #include "base/qt/qt_key_modifiers.h"
@@ -285,6 +286,8 @@ void Controller::createWindow() {
 
 	_container->show();
 	window->show();
+
+	Arcanegram::StreamerMode::ApplyTo(window);
 }
 
 void Controller::createWebview(const Webview::StorageId &storageId) {
diff --git a/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp b/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
+++ b/Telegram/SourceFiles/media/view/media_view_overlay_widget.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "media/view/media_view_overlay_widget.h"
 
+#include "arcanegram/features/streamer_mode/ag_streamer_mode.h"
 #include "apiwrap.h"
 #include "api/api_attached_stickers.h"
 #include "api/api_peer_photo.h"
@@ -4274,6 +4275,8 @@ void OverlayWidget::activate() {
 	setFocus();
 	QApplication::setActiveWindow(_window);
 	setFocus();
+
+	Arcanegram::StreamerMode::ApplyTo(_window);
 }
 
 void OverlayWidget::show(OpenRequest request) {
diff --git a/Telegram/SourceFiles/media/view/media_view_pip.cpp b/Telegram/SourceFiles/media/view/media_view_pip.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/media/view/media_view_pip.cpp
+++ b/Telegram/SourceFiles/media/view/media_view_pip.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "media/view/media_view_pip.h"
 
+#include "arcanegram/features/streamer_mode/ag_streamer_mode.h"
 #include "media/streaming/media_streaming_player.h"
 #include "media/streaming/media_streaming_document.h"
 #include "media/streaming/media_streaming_utility.h"
@@ -983,6 +984,8 @@ void Pip::setupPanel() {
 	_panel.setPosition(Deserialize(_delegate->pipLoadGeometry()));
 	_panel.widget()->show();
 
+	Arcanegram::StreamerMode::ApplyTo(_panel.widget());
+
 	_panel.saveGeometryRequests(
 	) | rpl::on_next([=] {
 		saveGeometry();
diff --git a/Telegram/SourceFiles/window/notifications_manager_default.cpp b/Telegram/SourceFiles/window/notifications_manager_default.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/window/notifications_manager_default.cpp
+++ b/Telegram/SourceFiles/window/notifications_manager_default.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "window/notifications_manager_default.h"
 
+#include "arcanegram/features/streamer_mode/ag_streamer_mode.h"
 #include "platform/platform_notifications_manager.h"
 #include "platform/platform_specific.h"
 #include "core/application.h"
@@ -714,6 +715,8 @@ Notification::Notification(
 	}, lifetime());
 
 	show();
+
+	Arcanegram::StreamerMode::ApplyTo(this);
 }
 
 void Notification::updateReplyGeometry() {
@@ -1271,6 +1274,8 @@ HideAllButton::HideAllButton(
 	}, lifetime());
 
 	show();
+
+	Arcanegram::StreamerMode::ApplyTo(this);
 }
 
 void HideAllButton::startHiding() {
-- 
