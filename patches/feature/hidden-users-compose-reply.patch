From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devilreef <devilreef@shino.boo>
Date: Tue, 28 Apr 2026 21:42:11 +0600
Subject: [PATCH] replace reply preview text when composing a reply to a hidden
 user

---
 Telegram/SourceFiles/history/history_widget.cpp            | 7 +++++++
 .../view/controls/history_view_compose_controls.cpp        | 7 ++++++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/history/history_widget.cpp
+++ b/Telegram/SourceFiles/history/history_widget.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "history/history_widget.h"
 
+#include "arcanegram/features/ag_hidden_users.h"
 #include "api/api_compose_with_ai.h"
 #include "api/api_editing.h"
 #include "api/api_bot.h"
@@ -10495,6 +10496,12 @@ void HistoryWidget::updateReplyEditText(not_null<HistoryItem*> item) {
 		.repaint = [=] { updateField(); },
 	});
 	const auto text = [&] {
+		if (!_editMsgId
+			&& Arcanegram::HiddenUsers::IsHiddenItem(item)) {
+			return TextWithEntities{
+				tr::ag_hidden_user_message(tr::now),
+			};
+		}
 		const auto media = (_replyTo.todoItemId
 				|| !_replyTo.pollOption.isEmpty())
 			? item->media()
diff --git a/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp b/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
+++ b/Telegram/SourceFiles/history/view/controls/history_view_compose_controls.cpp
@@ -7,6 +7,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "history/view/controls/history_view_compose_controls.h"
 
+#include "arcanegram/features/ag_hidden_users.h"
 #include "base/call_delayed.h"
 #include "base/event_filter.h"
 #include "base/options.h"
@@ -507,9 +508,13 @@ void FieldHeader::updateShownMessageText() {
 		.repaint = [=] { customEmojiRepaint(); },
 	});
 	const auto reply = replyingToMessage();
+	const auto hidden = !isEditingMessage()
+		&& Arcanegram::HiddenUsers::IsHiddenItem(_shownMessage);
 	_shownMessageText.setMarkedText(
 		st::messageTextStyle,
-		((isEditingMessage() || reply.quote.empty())
+		(hidden
+			? TextWithEntities{ tr::ag_hidden_user_message(tr::now) }
+			: (isEditingMessage() || reply.quote.empty())
 			? _shownMessage->inReplyText()
 			: reply.quote),
 		Ui::DialogTextOptions(),
-- 
2.52.0.windows.1

