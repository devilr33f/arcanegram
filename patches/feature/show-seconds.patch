 .../history/view/history_view_bottom_info.cpp            | 3 ++-
 Telegram/SourceFiles/lang/lang_keys.cpp                  | 5 +++--
 Telegram/SourceFiles/ui/text/format_values.cpp           | 9 +++++----
 4 files changed, 14 insertions(+), 10 deletions(-)

diff --git a/Telegram/SourceFiles/api/api_who_reacted.cpp b/Telegram/SourceFiles/api/api_who_reacted.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/api/api_who_reacted.cpp
+++ b/Telegram/SourceFiles/api/api_who_reacted.cpp
@@ -30,6 +30,7 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "apiwrap.h"
 #include "styles/style_chat.h"
 #include "styles/style_chat_helpers.h"
+#include "arcanegram/features/ag_show_seconds.h"
 
 namespace Api {
 namespace {
@@ -711,19 +712,19 @@ QString FormatReadDate(TimeId date, const QDateTime &now) {
 		return tr::lng_mediaview_today(
 			tr::now,
 			lt_time,
-			QLocale().toString(parsed.time(), QLocale::ShortFormat));
+			Arcanegram::Time::FormatShort(parsed.time()));
 	} else if (readDate.addDays(1) == nowDate) {
 		return tr::lng_mediaview_yesterday(
 			tr::now,
 			lt_time,
-			QLocale().toString(parsed.time(), QLocale::ShortFormat));
+			Arcanegram::Time::FormatShort(parsed.time()));
 	}
 	return tr::lng_mediaview_date_time(
 		tr::now,
 		lt_date,
 		langDayOfMonthShort(readDate),
 		lt_time,
-		QLocale().toString(parsed.time(), QLocale::ShortFormat));
+		Arcanegram::Time::FormatShort(parsed.time()));
 }
 
