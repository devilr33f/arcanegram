From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devilreef <devilreef@femboy.page>
Date: Wed, 29 Apr 2026 14:06:41 +0600
Subject: [PATCH] extend copy-id internal url handler with optional mtproto
 suffix

---
 Telegram/SourceFiles/core/local_url_handlers.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/core/local_url_handlers.cpp b/Telegram/SourceFiles/core/local_url_handlers.cpp
index 0000000..0000000 100644
--- a/Telegram/SourceFiles/core/local_url_handlers.cpp
+++ b/Telegram/SourceFiles/core/local_url_handlers.cpp
@@ -1818,7 +1818,7 @@ const std::vector<LocalUrlHandler> &InternalUrlHandlers() {
 			OpenExternalLink
 		},
 		{
-			u"^copy:(.+)$"_q,
+			u"^copy:([^:]+)(?::mtproto:([0-9]+))?$"_q,
 			CopyPeerId
 		},
 		{
